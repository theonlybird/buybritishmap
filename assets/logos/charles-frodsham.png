    <script type="text/javascript">
        // check if the cookie has already been set, if not display the notice
        cookieValue = $.cookie('Frodshamaccept');
        if(cookieValue != 'Yes') {
            $("<div id='cookieNotice'><a href='#' class='cookieButton' onClick='acceptCookieNotice()'>Accept cookies</a> <a href='#' class='cookieButton' onClick='declineCookieNotice()'>Decline cookies</a><p>We use cookies to improve your experience of our website. <a href='https://frodsham.com/privacy/'>Privacy Policy</a></p></div>").appendTo("div#cookieWrapper");
            $('#cookieNotice').hide().fadeIn(2000);
        } 
        // if the user accepts the cookie notice hide the div and set a cookie to remember that decision
        function acceptCookieNotice(){
            $.cookie('Frodshamaccept', 'Yes', { expires: 1000, path: '/' });
            document.getElementById("cookieNotice").className += "hide";
            
            // we have consent so use GA now
              window.dataLayer = window.dataLayer || [];
              function gtag(){dataLayer.push(arguments);}
              gtag('js', new Date());

              gtag('config', 'UA-111441801-1');
        }
        
        
        // decline - don't set any cookies, just hide the notice
        function declineCookieNotice(){
            document.getElementById("cookieNotice").className += "hide";
        }
        </script>
