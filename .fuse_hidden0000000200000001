<link rel="stylesheet" href="assets/theme.css" />
<style>
  /* Palette and type live in assets/theme.css */
  *{box-sizing:border-box}
  html,body{margin:0;font-family:var(--font-body);color:var(--ink);background:var(--bg);-webkit-text-size-adjust:100%}
  #topbar{position:relative;height:64px;background:#fff;border-bottom:1px solid var(--line);display:flex;align-items:center;justify-content:center;z-index:1100}
  #topbar .flag{position:absolute;left:0;top:0;bottom:0;width:230px;opacity:.16;pointer-events:none;
    -webkit-mask-image:linear-gradient(100deg,#000 0%,#000 25%,transparent 85%);
    mask-image:linear-gradient(100deg,#000 0%,#000 25%,transparent 85%)}
  #topbar .flag svg{width:100%;height:100%;display:block}
  .site-title{margin:0;font-size:24px;letter-spacing:1px;color:var(--navy);font-weight:800}
  .site-title span{color:var(--red)}
  .site-title a{color:inherit;text-decoration:none}
  #burger{position:absolute;right:14px;top:50%;transform:translateY(-50%);width:42px;height:42px;border:1px solid var(--line);border-radius:9px;background:#fff;cursor:pointer;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:5px;padding:0}
  #burger:hover{border-color:var(--navy)}
  #burger .bar{width:20px;height:2px;background:var(--navy);border-radius:2px}
  #menu{position:absolute;right:10px;top:60px;background:#fff;border:1px solid var(--line);border-radius:11px;box-shadow:0 8px 24px rgba(0,0,0,.13);min-width:210px;padding:6px;z-index:1200}
  #menu a{display:block;padding:10px 14px;border-radius:8px;font-size:14px;font-weight:600;color:var(--ink);text-decoration:none}
  #menu a:hover{background:var(--bg);color:var(--navy)}
  #menu a.cta{background:var(--red);color:#fff;margin-top:4px;text-align:center}
  #menu a.cta:hover{filter:brightness(1.08)}
  .wrap{max-width:680px;margin:0 auto;padding:28px 18px 60px}
  .card{background:#fff;border:1px solid var(--line);border-radius:12px;padding:24px}
  h2{margin:0 0 12px;font-size:20px;color:var(--navy)}
  h3{margin:22px 0 6px;font-size:15.5px;color:var(--navy)}
  p,li{font-size:14.5px;line-height:1.65;color:#39434e}
  a{color:var(--navy)}
  .tag{display:inline-block;font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.4px;padding:2px 6px;border-radius:4px}
  .tag.gold{background:#f6edd2;color:#7a5a12}
  .tag.silver{background:#eceff2;color:#566069}

  h1,h2,h3,.brand-logo,.g-title,.pop h3{font-family:var(--font-heading)}
  .brand-logo{font-family:var(--font-heading);font-size:25px;font-weight:700;color:var(--racing-green);letter-spacing:.2px;text-decoration:none;line-height:1;white-space:nowrap}


  /* ==========================================================================
     RESPONSIVE  —  shared across the content pages.
     The layout is a single column already, so this is about the header,
     touch targets, comfortable reading measure and iOS input zoom.
     ========================================================================== */
  #topbar{padding:0 calc(14px + env(safe-area-inset-right,0px)) 0 calc(14px + env(safe-area-inset-left,0px))}
  #burger{right:calc(14px + env(safe-area-inset-right,0px))}

  @media (max-width:1099px){
    .wrap{padding:24px 16px 56px}
    .card{padding:20px}
  }

  @media (max-width:767px){
    #topbar{height:56px;justify-content:flex-start}
    .brand-logo{font-size:19px;max-width:calc(100% - 60px);overflow:hidden;text-overflow:ellipsis}
    #burger{width:44px;height:44px;right:calc(12px + env(safe-area-inset-right,0px))}
    #topbar .flag{width:110px}
    #menu{top:52px;left:calc(12px + env(safe-area-inset-left,0px));right:calc(12px + env(safe-area-inset-right,0px));min-width:0}
    #menu a{padding:13px 14px;font-size:15px}
    .wrap{padding:16px 12px calc(48px + env(safe-area-inset-bottom,0px))}
    .card{padding:18px 16px;border-radius:12px}
    h2{font-size:19px}
    h3{font-size:15.5px}
    p,li{font-size:15px;line-height:1.7}
  }

  @media (max-width:359px){
    .brand-logo{font-size:17px}
  }


  /* ==========================================================================
     DESIGN SYSTEM OVERRIDES — see assets/theme.css
     ========================================================================== */
  html,body{background:var(--paper);color:var(--ink);font-family:var(--font-body)}
  h1,h2,h3,h4{font-family:var(--font-heading);color:var(--green);font-weight:500;letter-spacing:.01em}
  h1{font-size:clamp(30px,4.4vw,46px);line-height:1.1}
  h2{font-size:25px}
  h3{font-size:19px}
  p,li{color:var(--muted);font-size:15px;line-height:1.7}
  a{color:var(--green)}
  a:hover{color:var(--green-dark)}

  #topbar{background:var(--paper-2);border-bottom:1px solid var(--line)}
  #topbar .flag{display:none}
  .site-title,.brand-logo{font-family:var(--font-heading);font-weight:600;font-size:25px;
    letter-spacing:.01em;color:var(--green);text-transform:none}
  .site-title span{color:var(--green)}
  #burger{background:var(--surface);border-color:var(--line);border-radius:6px}
  #burger:hover{border-color:var(--green)}
  #burger .bar{background:var(--green)}
  #menu{background:var(--surface);border-color:var(--line);border-radius:8px}
  #menu a{color:var(--ink);font-weight:500;border-bottom:none}
  #menu a:hover{background:var(--paper-2);color:var(--green)}
  #menu a.cta{background:var(--green);color:var(--paper)}

  .card,.rules,.standards,.notice{background:var(--surface);border:1px solid var(--line-strong);
    border-radius:6px;box-shadow:none}
  .lede{color:var(--muted);font-size:17px;line-height:1.65}
  .note,.hint,.sub,.opt{color:var(--muted-2)}
  .cta,button[type=submit],.ok{background:var(--green);color:var(--paper);border:none;
    border-radius:6px;font-family:var(--font-body);font-weight:500;letter-spacing:.03em}
  .cta:hover,button[type=submit]:hover{background:var(--green-dark)}
  input,select,textarea{font-family:var(--font-body);background:var(--surface);
    border:1px solid var(--line);border-radius:6px;color:var(--ink)}
  input:focus,select:focus,textarea:focus{outline:none;border-color:var(--green);
    box-shadow:0 0 0 3px rgba(0,66,37,.10)}

  .tag{font-family:var(--font-body);font-size:10px;font-weight:600;letter-spacing:.1em;
    text-transform:uppercase;border-radius:3px;padding:3px 7px}
  .tag.gold,.gold-cell,.standard.is-gold{background:var(--gold-bg);color:var(--gold-mark)}
  .tag.silver,.silver-cell{background:var(--silver-bg);color:var(--silver-mark)}
  .gold-col,.g{color:var(--gold-mark)}
  .silver-col,.s{color:var(--silver-mark)}
  .cat,.eg{color:var(--muted-2)}
  table{border-color:var(--line)}
  th,td{border-color:var(--line)!important}
  th{font-family:var(--font-body);color:var(--green);font-weight:600;
    text-transform:uppercase;letter-spacing:.09em;font-size:11px}

</style>
